+/* Single-threaded stand-in for pthread_create/join/detach: without -pthread a module
+   cannot start a thread at all, so the body is recorded here and run on the calling
+   thread at join time, by which point its producer has closed the queue it reads.
+   Handles count up from 1 so std::thread::id keeps spawn order under std::map, which
+   is the order SimpleThreadPool::join_all() replays them in. */
+
+#include <pthread.h>
+#include <stddef.h>
+#include <vector>
+
+namespace {
+
+struct DeferredThread {
+	void* (*fn)(void*);
+	void* arg;
+	void* ret;
+	bool ran;
+};
+
+std::vector<DeferredThread>& registry() {
+	static std::vector<DeferredThread>* r = new std::vector<DeferredThread>(1);
+	return *r;
+}
+
+void run_once(size_t handle) {
+	if (handle == 0 || handle >= registry().size())
+		return;
+	// Not a reference: the body may itself call pthread_create and reallocate.
+	if (registry()[handle].ran)
+		return;
+	registry()[handle].ran = true;
+	void* (*fn)(void*) = registry()[handle].fn;
+	void* arg = registry()[handle].arg;
+	void* ret = fn(arg);
+	registry()[handle].ret = ret;
+}
+
+}
+
+extern "C" {
+
+int pthread_create(pthread_t* thread, const pthread_attr_t*, void* (*start_routine)(void*), void* arg) {
+	DeferredThread t;
+	t.fn = start_routine;
+	t.arg = arg;
+	t.ret = NULL;
+	t.ran = false;
+	registry().push_back(t);
+	*thread = (pthread_t)(registry().size() - 1);
+	return 0;
+}
+
+int pthread_join(pthread_t thread, void** retval) {
+	const size_t handle = (size_t)thread;
+	run_once(handle);
+	if (retval != NULL)
+		*retval = (handle > 0 && handle < registry().size()) ? registry()[handle].ret : NULL;
+	return 0;
+}
+
+int pthread_detach(pthread_t thread) {
+	run_once((size_t)thread);
+	return 0;
+}
+
+}
