 #include "easel.h"
 #include <syslog.h>
 
+/* biowasm: Easel decides whether it is running as a daemon -- and so whether to
+ * send errors to syslog instead of stderr -- by testing getppid() == 1. Under
+ * Emscripten getppid() always returns 1, so every error and exception went to
+ * vsyslog(); musl's syslog opens a unix socket, which aborts the module. That
+ * turned any reportable error into a crash with no message. There are no
+ * daemons in a browser, so always take the "print it" branch.
+ */
+#ifdef __EMSCRIPTEN__
+#define esl_is_daemon() (0)
+#else
+#define esl_is_daemon() (getppid() == 1)
+#endif
+
