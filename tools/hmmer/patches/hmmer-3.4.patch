--- a/src/impl_sse/decoding.c
+++ b/src/impl_sse/decoding.c
@@ -12,7 +12,7 @@
 #include <stdio.h>
 #include <math.h>
 
-#include <x86intrin.h>
+#include <emmintrin.h>
 
 #include "easel.h"
 #include "esl_sse.h"
--- a/src/impl_sse/p7_oprofile.c
+++ b/src/impl_sse/p7_oprofile.c
@@ -669,7 +669,13 @@
   uint8_t b;
 
   sc  = -1.0f * roundf(om->scale_b * sc);                          /* ugh. sc is now an integer cost represented in a float...           */
-  b   = (sc > 255 - om->bias_b) ? 255 : (uint8_t) sc + om->bias_b; /* and now we cast, saturate, and bias it to an unsigned char cost... */
+  /* biowasm: (uint8_t) of a negative float is undefined behaviour. x86 wraps it
+   * mod 256, which is what the bias addition below relies on; WebAssembly
+   * saturates it to 0 instead, so every positive-scoring emission came out as a
+   * cost of bias_b and nothing ever passed the MSV filter. Doing the arithmetic
+   * in int gives x86's answer on both.
+   */
+  b   = (sc > 255 - om->bias_b) ? 255 : (uint8_t) ((int) sc + om->bias_b); /* and now we cast, saturate, and bias it to an unsigned char cost... */
   return b;
 }
  
