 FILE_FLAGS     := -D_LARGEFILE_SOURCE -D_FILE_OFFSET_BITS=64 -D_GNU_SOURCE
 DEBUG_DEFS     = -DCOMPILER_OPTIONS="\"$(DEBUG_FLAGS) $(CXXFLAGS)\""
 RELEASE_DEFS   = -DCOMPILER_OPTIONS="\"$(RELEASE_FLAGS) $(CXXFLAGS)\""
+
+# if compiling to WebAssembly with Emscripten, overwrite some configs
+ifeq (em++,$(shell basename $(CXX)))
+  BITS := 64
+  # Output name, so the SIMD and non-SIMD builds can live side by side. It must be
+  # set at build time: the glue code hardcodes the matching .data filename, so
+  # renaming the files afterwards breaks the pairing.
+  PROGRAM ?= bowtie2-align-s
+ifeq ($(SIMD),1)
+  # Compile the SSE2 alignment kernels (aligner_swsse_*.cpp) to WebAssembly SIMD
+  SSE_FLAG := -msse2 -msimd128
+else
+  # Disable SIMD and use SIMDe to simulate it. Defining "__aarch64__" is what
+  # makes sse_wrap.h pick the SIMDe branch instead of <emmintrin.h>.
+  SSE_FLAG :=
+  FILE_FLAGS += -D__aarch64__
+endif
+  CXXFLAGS += -fopenmp-simd
+  CPPFLAGS += -Ithird_party/simde
+  # Remove "-g3" debug flag to reduce .wasm size
+  RELEASE_FLAGS := -O3 $(SSE_FLAG) -funroll-loops
+  # A few more flags
+  FILE_FLAGS += -s TOTAL_MEMORY=100MB
+  # TODO: how would memory-mapped files behave in the browser?
+  BOWTIE_MM :=
+  BOWTIE_SHARED_MEM :=
+endif
 
