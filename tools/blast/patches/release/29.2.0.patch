@@ -5644,6 +5645,30 @@ CMemoryFileSegment::CMemoryFileSegment(SMemoryFileHandle& handle,
     if ( m_DataPtrReal == MAP_FAILED ) {
         m_DataPtrReal = 0;
         errmsg = NcbiSys_strerror(errno);
+#  ifdef __EMSCRIPTEN__
+        // Emscripten has no mmap for files on PROXYFS, so a database that lives on
+        // another module's filesystem cannot be mapped. Read the region into the heap
+        // instead; that is indistinguishable for a read-only mapping. Shared writable
+        // mappings would need write-back on flush, so leave those as a failure.
+        if ( !((attrs.map_protect & PROT_WRITE) &&
+               (attrs.map_access & MAP_SHARED)) ) {
+            void* buf = malloc(m_LengthReal);
+            if ( buf ) {
+                ssize_t n = pread(handle.hMap, buf, m_LengthReal,
+                                  (off_t) m_OffsetReal);
+                if ( n >= 0 ) {
+                    if ( (size_t) n < m_LengthReal ) {
+                        memset((char*) buf + n, 0, m_LengthReal - (size_t) n);
+                    }
+                    m_DataPtrReal = buf;
+                    m_Emulated = true;
+                    errmsg.clear();
+                } else {
+                    free(buf);
+                }
+            }
+        }
+#  endif
     }
 #endif
     if ( !m_DataPtrReal ) {
@@ -5678,6 +5703,9 @@ bool CMemoryFileSegment::Flush(void) const
         return false;
     }
 #elif defined(NCBI_OS_UNIX)
+    if ( m_Emulated ) {
+        return true;
+    }
     status = (msync((char*)m_DataPtrReal, m_LengthReal, MS_SYNC) == 0);
     if ( !status ) {
         LOG_ERROR_ERRNO(87, "CMemoryFileSegment::Flush(): Cannot flush memory segment");
@@ -5703,6 +5731,13 @@ bool CMemoryFileSegment::Unmap(void)
         return false;
     }
 #elif defined(NCBI_OS_UNIX)
+    if ( m_Emulated ) {
+        free(m_DataPtrReal);
+        m_DataPtrReal = 0;
+        m_Emulated = false;
+        m_DataPtr = 0;
+        return true;
+    }
     status = (munmap((char*)m_DataPtrReal, (size_t) m_LengthReal) == 0);
     if (!status) {
         LOG_ERROR_ERRNO(88, "CMemoryFileSegment::Unmap(): Cannot unmap memory segment");
